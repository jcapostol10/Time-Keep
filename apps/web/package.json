{
  "name": "@timekeep/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "e2e": "dotenv -e ../../.env -- playwright test",
    "storage:init": "dotenv -e ../../.env -- tsx scripts/storage-init.ts",
    "vercel-build": "tsx scripts/vercel-build.ts",
    "e2e:coverage": "tsx scripts/coverage-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "@timekeep/core": "workspace:*",
    "@timekeep/db": "workspace:*",
    "@timekeep/ui": "workspace:*",
    "better-auth": "^1.7.7",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@timekeep/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15"
  }
}
