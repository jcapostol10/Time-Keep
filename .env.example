# Copy to .env at the repo root. Every app and package reads this single file.
# NEVER commit .env — this repository is public.

# --- Database (docker compose) ---------------------------------------------
DATABASE_URL=postgres://timekeep:timekeep@localhost:5432/timekeep
# Used by integration tests; created automatically by docker/postgres-init.sql.
# NEVER point this at a shared database: the tests truncate every table.
TEST_DATABASE_URL=postgres://timekeep:timekeep@localhost:5432/timekeep_test
# Supabase only: session-pooler URL (port 5432) for migrations, seed and e2e
# cleanup. DATABASE_URL is then the transaction pooler (port 6543). Leave
# unset locally; scripts fall back to DATABASE_URL.
# DATABASE_URL_SESSION=

# --- Auth (Better Auth) -----------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes-base64
# Leave both unset on Vercel previews: the deployment URL (VERCEL_URL) is used.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Leave blank to hide the "Continue with Google" button.
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origin: http://localhost:3000   (your public URL in production)
#   Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth endpoint rate limiting: defaults to on in production, off otherwise.
# Set to "false" when running the e2e suite against a production build.
# AUTH_RATE_LIMIT_ENABLED=true

# --- Email (Mailpit locally; any SMTP in production) ------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="TimeKeep <no-reply@timekeep.local>"
# Mailpit HTTP API, used by the e2e tests to read verification/invite emails
MAILPIT_URL=http://localhost:8025

# --- File storage (RustFS locally; any S3-compatible bucket in production) ---
# `pnpm storage:init` creates the bucket and allows anonymous reads of avatars/logos.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=timekeep
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
# Public base URL for objects in the bucket (avatars, logos)
S3_PUBLIC_URL=http://localhost:9000/timekeep
# Private bucket for report exports (presigned downloads only). Create it as a
# private bucket in Supabase for production and previews.
S3_EXPORT_BUCKET=timekeep-exports
# Exports with more rows than this become export jobs (built after the response).
EXPORT_JOB_THRESHOLD=10000
# Local only, optional: a Chrome/Chromium binary for PDF exports.
# CHROME_PATH=

# --- Vercel preview deployments + remote e2e ---------------------------------
# Preview only: store outgoing email instead of sending it, so the e2e suite
# can read it from /api/test/emails. Ignored in production.
# MAIL_CAPTURE=true
# Shared secret for /api/test/emails (at least 16 characters). Preview + CI only.
# E2E_SECRET=
# Test runner only: run `pnpm e2e` against a deployment instead of local Docker.
# E2E_BASE_URL=https://<deployment>.vercel.app
# VERCEL_AUTOMATION_BYPASS_SECRET=
