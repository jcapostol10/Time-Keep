{
  "name": "@timekeep/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./migrate": "./src/migrate.ts",
    "./migrations-status": "./src/migrations-status.ts",
    "./e2e-tenant": "./src/e2e-tenant.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- tsx src/migrate.ts",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "db:e2e-cleanup": "dotenv -e ../../.env -- tsx src/e2e-cleanup.ts",
    "db:seed:perf": "dotenv -e ../../.env -- tsx src/seed-perf.ts"
  },
  "dependencies": {
    "@timekeep/core": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@timekeep/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
